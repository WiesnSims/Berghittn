[&"", &"UI_STECK_BSUNDAN"]: [&"A Bsundana"],
[&"", &"UI_STECK_KILLS"]: [&"Von dir erlegt: %d"],
[&"", &"UI_STECK_UNKNOWN"]: [&"Noch nie gesehen. Irgendwann taucht er in einem Spiel auf."],
[&"", &"STECK_WANDERER"]: [&"Ein Wanderer, der die Hütte nie gefunden hat. Langsam, aber es kommen immer mehr; steigt durch die Fenster ein."],
[&"", &"STECK_TOURIST"]: [&"Schnell und schwach, ab Welle 3. Kommt angerannt, bevor du nachgeladen hast."],
[&"", &"STECK_KNAPPE"]: [&"Der Bergknappe, ab Welle 6: langsam, sehr zäh und schlägt hart zu. Auf den Kopf zielen."],
[&"", &"STECK_PERCHTE"]: [&"Holzmaske, ab Welle 8. Duckt sich kurz, dann springt sie dich an: zur Seite treten."],
[&"", &"STECK_KRAMPUS"]: [&"Der Boss jeder 5. Welle, mit sechs Wanderern. Riesig, kaum aufzuhalten, und er schlägt hart zu."],
[&"", &"STECK_VENEDIGERMANDL"]: [&"Ein kleiner Goldgräber aus Venedig. Greift nie an, flitzt davon: Triff ihn, bevor er verschwindet, für einen Haufen Punkte."],
[&"", &"STECK_WILDERER"]: [&"Der Wilderer hält Abstand und schießt. Wenn sein Zielfernrohr blitzt: in Deckung."],
[&"", &"STECK_BERGDOHLE"]: [&"Bergdohlen im Schwarm. Fliegen durch jedes Fenster und picken; je ein guter Treffer."],
[&"", &"STECK_KASSIER"]: [&"Jeder Schlag kostet dich 150 Punkte Mitgliedsbeitrag. Erlegst du ihn, bekommst du alles zurück, und mehr."],
[&"", &"STECK_BERGFUEHRER"]: [&"Bringt vier Wanderer am Seil mit. Erlegst du ihn, stolpert die ganze Seilschaft."],
[&"", &"STECK_TRAILRUNNER"]: [&"Stürmt geradeaus und wirft dich um. Lass ihn gegen eine Wand laufen: dann ist er benommen."],
[&"", &"STECK_INFLUENCER"]: [&"Geht live: Die Gegner um ihn werden schneller, und sein Ringlicht blendet dich. Wegschauen."],
[&"", &"STECK_SPRENGMEISTER"]: [&"Zündet die Lunte, wenn du nahe kommst, und fliegt in die Luft. Früh abschießen, oder mitten in der Menge."],
[&"", &"STECK_SCHOENPERCHTE"]: [&"Greift nie an, heilt aber jeden Gegner in ihrer Nähe. Schieß ihr die Tafel ab, oder sie zuerst."],
